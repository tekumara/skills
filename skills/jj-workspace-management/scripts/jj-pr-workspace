#!/usr/bin/env python3
"""Create a JJ workspace for a GitHub pull request without checking out Git HEAD."""

from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any


class CommandError(RuntimeError):
    def __init__(self, command: list[str], returncode: int, stdout: str, stderr: str) -> None:
        self.command = command
        self.returncode = returncode
        self.stdout = stdout
        self.stderr = stderr
        super().__init__(f"command failed with exit {returncode}: {' '.join(command)}")


def run(command: list[str], *, cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    proc = subprocess.run(command, cwd=cwd, text=True, capture_output=True, check=False)
    if check and proc.returncode != 0:
        raise CommandError(command, proc.returncode, proc.stdout, proc.stderr)
    return proc


def require_tool(name: str) -> None:
    if not shutil.which(name):
        raise RuntimeError(f"required tool not found on PATH: {name}")


def jj_template(rev: str, template: str, cwd: Path) -> str:
    return run(["jj", "log", "-r", rev, "--no-graph", "-T", template], cwd=cwd).stdout.strip()


def normalize_git_url(url: str) -> str:
    value = url.strip()
    value = re.sub(r"^git@github\.com:", "https://github.com/", value)
    value = re.sub(r"^ssh://git@github\.com/", "https://github.com/", value)
    value = value.removesuffix(".git")
    return value.rstrip("/").lower()


def jj_git_remotes(cwd: Path) -> dict[str, str]:
    remotes: dict[str, str] = {}
    proc = run(["jj", "git", "remote", "list"], cwd=cwd)
    for line in proc.stdout.splitlines():
        if not line:
            continue
        name, _, url = line.partition(" ")
        if name and url:
            remotes[name] = url.strip()
    return remotes


def safe_remote_name(name: str) -> str:
    remote = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-._").lower()
    return remote or "pr-remote"


def pr_remote_name(owner_login: str, pr_number: int) -> str:
    return f"pr-{pr_number}-{safe_remote_name(owner_login)}"


def ensure_pr_remote(cwd: Path, remote_name: str, head_repo_url: str) -> bool:
    remotes = jj_git_remotes(cwd)
    existing_url = remotes.get(remote_name)
    if existing_url is None:
        run(["jj", "git", "remote", "add", remote_name, head_repo_url], cwd=cwd)
        return True
    if normalize_git_url(existing_url) != normalize_git_url(head_repo_url):
        raise RuntimeError(
            f"remote {remote_name} already exists with URL {existing_url}, expected {head_repo_url}"
        )
    return False


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Create a new JJ workspace at a GitHub PR head without running `gh pr checkout`.",
    )
    parser.add_argument("pr", help="GitHub PR URL or number accepted by `gh pr view`.")
    parser.add_argument("workspace_path", help="Path for the new JJ workspace. It must not already exist.")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    for tool in ("gh", "jj"):
        require_tool(tool)

    start_cwd = Path.cwd()
    jj_root = Path(run(["jj", "root"], cwd=start_cwd).stdout.strip())

    workspace_path = Path(args.workspace_path).expanduser()
    if not workspace_path.is_absolute():
        workspace_path = (start_cwd / workspace_path).resolve()
    if workspace_path.exists():
        raise RuntimeError(f"workspace path already exists: {workspace_path}")

    before_commit = jj_template("@", 'commit_id ++ "\\n"', jj_root)
    before_change = jj_template("@", 'change_id ++ "\\n"', jj_root)
    before_workspace = jj_template("@", 'working_copies ++ "\\n"', jj_root)

    pr_json = run(
        [
            "gh",
            "pr",
            "view",
            args.pr,
            "--json",
            "number,headRefName,headRefOid,headRepository,headRepositoryOwner,url",
        ],
        cwd=jj_root,
    ).stdout
    pr_info: dict[str, Any] = json.loads(pr_json)
    number = pr_info["number"]
    head_ref_name = pr_info["headRefName"]
    head_ref_oid = pr_info["headRefOid"]
    head_repo = pr_info["headRepository"]["nameWithOwner"]
    owner_login = pr_info["headRepositoryOwner"]["login"]
    head_repo_url = f"https://github.com/{head_repo}.git"
    remote_name = pr_remote_name(owner_login, number)

    print(f"Ensuring JJ/Git remote {remote_name} for {head_repo_url}", file=sys.stderr)
    remote_added = ensure_pr_remote(jj_root, remote_name, head_repo_url)

    print(f"Fetching PR #{number} from {remote_name}:{head_ref_name}", file=sys.stderr)
    run(["jj", "git", "fetch", "--remote", remote_name, "--branch", head_ref_name], cwd=jj_root)

    remote_rev = f"{head_ref_name}@{remote_name}"
    fetched_oid = jj_template(remote_rev, 'commit_id ++ "\\n"', jj_root)
    if fetched_oid != head_ref_oid:
        raise RuntimeError(f"fetched remote bookmark {remote_rev} is {fetched_oid}, but GitHub reported PR head {head_ref_oid}")

    print(f"Tracking PR branch with `jj bookmark track --remote {remote_name} {head_ref_name}`", file=sys.stderr)
    track_proc = run(["jj", "bookmark", "track", "--remote", remote_name, head_ref_name], cwd=jj_root)
    if track_proc.stdout:
        print(track_proc.stdout, file=sys.stderr, end="")
    if track_proc.stderr:
        print(track_proc.stderr, file=sys.stderr, end="")

    print(f"Creating JJ workspace at {workspace_path}", file=sys.stderr)
    run(["jj", "workspace", "add", str(workspace_path), "-r", remote_rev], cwd=jj_root)

    after_commit = jj_template("@", 'commit_id ++ "\\n"', jj_root)
    after_change = jj_template("@", 'change_id ++ "\\n"', jj_root)
    if after_commit != before_commit or after_change != before_change:
        raise RuntimeError(
            "current JJ workspace changed while creating the PR workspace. "
            f"Before {before_commit} {before_change}; after {after_commit} {after_change}."
        )

    workspace_status = run(["jj", "status"], cwd=workspace_path).stdout
    workspace_head = jj_template("@", 'commit_id ++ " " ++ change_id ++ "\\n"', workspace_path)
    workspace_parent = jj_template("@-", 'commit_id ++ " " ++ change_id ++ "\\n"', workspace_path)

    print(
        json.dumps(
            {
                "pr": pr_info["url"],
                "pr_number": number,
                "head_repo": head_repo,
                "head_ref": head_ref_name,
                "head_oid": head_ref_oid,
                "remote": remote_name,
                "remote_added": remote_added,
                "remote_bookmark": remote_rev,
                "tracked_bookmark": head_ref_name,
                "workspace_path": str(workspace_path),
                "workspace_head": workspace_head,
                "workspace_parent": workspace_parent,
                "original_workspace": before_workspace,
                "original_commit": before_commit,
                "original_change": before_change,
                "original_workspace_unchanged": True,
                "workspace_status": workspace_status,
                "push_hint": f"After committing, run `jj bookmark set {head_ref_name} -r @` then `jj git push --remote {remote_name} --bookmark {head_ref_name}`.",
            },
            indent=2,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except CommandError as exc:
        print(str(exc), file=sys.stderr)
        if exc.stdout:
            print("stdout:", file=sys.stderr)
            print(exc.stdout, file=sys.stderr)
        if exc.stderr:
            print("stderr:", file=sys.stderr)
            print(exc.stderr, file=sys.stderr)
        raise SystemExit(exc.returncode)
    except Exception as exc:
        print(f"error: {exc}", file=sys.stderr)
        raise SystemExit(1)
